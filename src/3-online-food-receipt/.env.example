# Google Gemini API key used for both receipt-image parsing and the Q&A agent.
LLM__GOOGLE_API_KEY=
LLM__MODEL_NAME=gemini-2.5-flash

# Postgres connection (see docker-compose.yml for local dev)
DATABASE__DSN=postgresql://postgres:postgres@localhost:5432/food_receipt
DATABASE__MIN_POOL_SIZE=1
DATABASE__MAX_POOL_SIZE=5

# Where uploaded receipt photos are stored on local disk
STORAGE__RECEIPTS_DIR=data/receipts
